{
  "schemaVersion": 1,
  "id": "autobridge",
  "version": "${version}",
  "name": "AutoBridge",
  "description": "Client-side bridging assistant. Simulates only sneaking and right-clicking through vanilla's own input path, never modifies your camera or movement.",
  "authors": [
    "peirooden"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/autobridge",
    "sources": "https://github.com/peirooden/autobridge",
    "issues": "https://github.com/peirooden/autobridge/issues"
  },
  "license": "MIT",
  "icon": "assets/autobridge/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.autobridge.AutoBridgeClient"
    ],
    "modmenu": [
      "com.autobridge.compat.AutoBridgeModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
